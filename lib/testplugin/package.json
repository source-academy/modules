{
  "name": "@sourceacademy/modules-testplugin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "In-memory Conductor IDataHandler implementation for testing Source Academy modules",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@sourceacademy/conductor": "catalog:"
  },
  "devDependencies": {
    "@sourceacademy/modules-buildtools": "workspace:^",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "scripts": {
    "build": "tsc --project ./tsconfig.prod.json",
    "lint": "eslint src",
    "postinstall": "yarn build",
    "tsc": "tsc --project ./tsconfig.json",
    "test": "buildtools test --project ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/source-academy/modules.git",
    "directory": "lib/testplugin"
  }
