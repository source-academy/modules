{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":label(dependencies)"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      // Match the release gate in `.yarnrc.yml`
      "minimumReleaseAge": "3 days"
    },
    {
      "matchPackageNames": [
        "/^@blueprintjs.*/"
      ],
      "groupName": "blueprintjs"
    },
    {
      "description": "Node is one version for every repository, decided on the documentation site (Node.js version); the types follow it.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    }
  ]
}
