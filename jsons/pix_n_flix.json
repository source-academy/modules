  "get_pixel": {
    "kind": "function",
    "name": "get_pixel",
    "description": "<p>Returns a reference to the pixel at position (x, y) of the given image - the legacy\nPixel-accessor API's entry point, kept alongside get_pixel_value/set_pixel_value. Read its\ncomponents with red_of/green_of/blue_of/alpha_of, or write to it with set_rgba (only\nmeaningful when image is a destination image, e.g. a filter's dest parameter).</p>",
    "params": [
      {
        "paramType": "regular",
        "type": "unknown",
        "name": "image"
      },
      {
        "paramType": "regular",
        "type": "number",
        "name": "x"
      },
      {
        "paramType": "regular",
        "type": "number",
        "name": "y"
      }
    ],
    "retType": "unknown"
  },
