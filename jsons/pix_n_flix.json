  "stop": {
    "kind": "function",
    "name": "stop",
    "description": "<p>Actually stops the video feed, matching sound's stop(): tells the tab to stop its capture\nloop and release the camera (<code>$stopStreaming</code>), and lets the Run reach its terminal status\nnaturally instead of running forever (<code>__endStreaming</code> - see its doc comment). Not required\nbefore the program otherwise ends (a hard Stop click or starting another Run terminates the\nWorker outright, tearing the tab down with it regardless of pending work), but without ever\ncalling this, a program that calls install_filter and nothing else keeps the feed running\nuntil the student explicitly stops it.</p>",
    "params": [],
    "retType": "void"
  }
